# AdOps360 — environment variables.
# Copy to .env and replace every example value. Never commit .env.
# On the EC2 instance .env must carry restricted file permissions (chmod 600):
# it holds the DSP API credentials.
# All values below are placeholders, not real credentials.

# ---------------------------------------------------------------------------
# Docker Compose project
# The compose files name the project adops360 (name: adops360), which prefixes
# its containers, network and volumes. The main checkout does not need this
# variable. Every other worktree of the repository must set a name of its own,
# for instance adops360-<branch>, or it shares the containers and the database
# of the main checkout: a reset of its data would wipe theirs. Changing the name
# of a folder that already has a stack starts it with new, empty volumes.
# Never set it on the production instance.
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME=adops360-<branch>

# ---------------------------------------------------------------------------
# PostgreSQL (db service)
# The backend's DATABASE_URL is composed from these in docker-compose.yml.
# ---------------------------------------------------------------------------
POSTGRES_USER=adops360
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adops360

# ---------------------------------------------------------------------------
# Microsoft Entra ID (required)
# The one identity provider. The backend and the frontend build read both; without
# either of them Compose and the backend refuse to start.
# Replace the placeholders with your tenant and application identifiers, and never
# commit real values: they live only in your own .env.
# The Entra application lists <origin>/callback as a redirect URI and the origin as
# a post-logout redirect URI. Changing them needs a frontend rebuild.
# ---------------------------------------------------------------------------
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-application-client-id

# ---------------------------------------------------------------------------
# AWS — S3 file storage
# Uploaded purchase-order and commercial-offer spreadsheets,
# and reports downloaded from the DSPs.
# ---------------------------------------------------------------------------
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=example-access-key-id
AWS_SECRET_ACCESS_KEY=example-secret-access-key
S3_BUCKET_NAME=example-adops360-bucket

# ---------------------------------------------------------------------------
# DSP API credentials
# ---------------------------------------------------------------------------
ADFORM_CLIENT_ID=example-adform-client-id
ADFORM_CLIENT_SECRET=example-adform-client-secret

EQUATIV_CLIENT_ID=example-equativ-client-id
EQUATIV_CLIENT_SECRET=example-equativ-client-secret

DISPLAYCE_CLIENT_ID=example-displayce-client-id
DISPLAYCE_CLIENT_SECRET=example-displayce-client-secret

# ---------------------------------------------------------------------------
# Production (docker-compose.prod.yml, docs/deploy.md)
# Public host name of the server, without scheme. nginx uses it for the TLS
# certificate path and the HTTP to HTTPS redirect.
# ---------------------------------------------------------------------------
SERVER_NAME=adops.example.com

# ---------------------------------------------------------------------------
# Frontend
# Public base URL the browser uses to reach the API, through nginx.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost/api
# Build variable. With the exact value "true" every Adform campaign and line name is drawn blurred and cannot be
# selected, for screenshots and demos. Leave it empty to show names normally. Changing it needs a frontend rebuild.
NEXT_PUBLIC_MASK_NAMES=

# ---------------------------------------------------------------------------
# Development
# Email of the development user, to whom seed_dev_data.py gives the operations and
# finance roles. It must be the email Entra puts in the token of your Microsoft user,
# who signs in through the development registration.
# The test issuer of the end-to-end tests needs nothing here: docker-compose.yml sets
# APP_ENV and TEST_ISSUER_PUBLIC_KEY_FILE itself. Run scripts/generate_test_issuer_keys.sh
# before the first `docker compose up`. Never set them in production.
# ---------------------------------------------------------------------------
SEED_USER_EMAIL=

# Time zone of "today" and of the D-7 to D-1 ingestion window (IANA name). Defaults to Europe/Madrid.
APP_TIMEZONE=Europe/Madrid
