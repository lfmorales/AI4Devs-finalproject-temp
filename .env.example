# AdOps360 — environment variables.
# Copy to .env and replace every example value. Never commit .env.
# On the EC2 instance .env must carry restricted file permissions (chmod 600):
# it holds the DSP API credentials.
# All values below are placeholders, not real credentials.

# ---------------------------------------------------------------------------
# PostgreSQL (db service)
# The backend's DATABASE_URL is composed from these in docker-compose.yml.
# ---------------------------------------------------------------------------
POSTGRES_USER=adops360
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adops360

# ---------------------------------------------------------------------------
# AWS Cognito (User Pool)
# Managed AWS service, not part of the Compose stack.
# The backend verifies ID tokens against the pool's JWKS; the frontend signs
# users in through the hosted UI (authorization code + PKCE, no client secret).
# The app client must list <origin>/callback as callback URL and <origin>/ as
# sign-out URL, e.g. http://localhost/callback and http://localhost/.
# ---------------------------------------------------------------------------
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
COGNITO_CLIENT_ID=exampleclientid0123456789
# Hosted UI domain, without https://
COGNITO_DOMAIN=your-prefix.auth.eu-central-1.amazoncognito.com

# ---------------------------------------------------------------------------
# AWS — S3 file storage
# Uploaded purchase-order and commercial-offer spreadsheets,
# and reports downloaded from the DSPs.
# ---------------------------------------------------------------------------
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=example-access-key-id
AWS_SECRET_ACCESS_KEY=example-secret-access-key
S3_BUCKET_NAME=example-adops360-bucket

# ---------------------------------------------------------------------------
# DSP API credentials
# ---------------------------------------------------------------------------
ADFORM_CLIENT_ID=example-adform-client-id
ADFORM_CLIENT_SECRET=example-adform-client-secret

EQUATIV_CLIENT_ID=example-equativ-client-id
EQUATIV_CLIENT_SECRET=example-equativ-client-secret

DISPLAYCE_CLIENT_ID=example-displayce-client-id
DISPLAYCE_CLIENT_SECRET=example-displayce-client-secret

# ---------------------------------------------------------------------------
# Production (docker-compose.prod.yml, docs/deploy.md)
# Public host name of the server, without scheme. nginx uses it for the TLS
# certificate path and the HTTP to HTTPS redirect.
# ---------------------------------------------------------------------------
SERVER_NAME=adops.example.com

# ---------------------------------------------------------------------------
# Frontend
# Public base URL the browser uses to reach the API, through nginx.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost/api
# Build variable. With the exact value "true" every Adform campaign and line name is drawn blurred and cannot be
# selected, for screenshots and demos. Leave it empty to show names normally. Changing it needs a frontend rebuild.
NEXT_PUBLIC_MASK_NAMES=

# ---------------------------------------------------------------------------
# Development
# Email for seed user with operations role (seed_dev_data.py)
# ---------------------------------------------------------------------------
SEED_USER_EMAIL=

# Time zone of "today" and of the D-7 to D-1 ingestion window (IANA name). Defaults to Europe/Madrid.
APP_TIMEZONE=Europe/Madrid
