# Production image: runtime dependencies only, no tests, no development seed, non-root.
# The development image is backend/Dockerfile; the test helpers run pytest in that one.

FROM python:3.12-slim AS build

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /app

# Dependencies come from the lockfile at build time, without the dev group (pytest and friends).
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev


FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

COPY --from=build /opt/venv /opt/venv
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./
# An allowlist, so a script added later (like the development seed) is not shipped by accident.
COPY scripts/__init__.py scripts/run_ingestion.py scripts/grant_roles.py scripts/adform_smoke.py ./scripts/

RUN useradd --system --uid 10001 adops360
USER adops360

EXPOSE 8000

# nginx serves the API under /api and strips the prefix; root-path keeps the OpenAPI docs consistent.
# Migrations are not run here: they are an explicit deployment step (alembic upgrade head).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--root-path", "/api", "--proxy-headers", "--forwarded-allow-ips", "*"]
